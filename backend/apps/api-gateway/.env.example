# API Gateway. Copy to .env for local development (never commit .env).
PORT=5000
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
JWT_PUBLIC_KEY_FILE=../../../infrastructure/secrets/jwt-public.pem
MAIN_API_URL=http://localhost:5000
# SomBill Frontend (unified port 3000)
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
DOCS_ENABLED=true
# Keep false while developing/testing hospitality & POS routes freely; set true in production to enforce JWT auth.
AUTH_ENFORCE_HOSPITALITY=false
