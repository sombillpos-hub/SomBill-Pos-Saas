# Main API / Unified SomBill Backend Server. Copy to .env for local development (never commit .env).
PORT=5000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:3000
# One PostgreSQL database per module. Use the migrator role for `pnpm db:migrate`, the app role for running the API.
IDENTITY_DATABASE_URL=postgresql://identity_app:change-me@localhost:5432/sombill_identity
ORGANIZATION_DATABASE_URL=postgresql://organization_app:change-me@localhost:5432/sombill_organization
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# PEM files from scripts/generate-jwt-keys.sh (or JWT_PRIVATE_KEY / JWT_PUBLIC_KEY as base64)
JWT_PRIVATE_KEY_FILE=../../../infrastructure/secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=../../../infrastructure/secrets/jwt-public.pem
# Local plain-http only. Production: true (HTTPS)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
# File uploads (local-disk storage; use a persistent volume in Docker)
STORAGE_LOCAL_DIR=./storage
UPLOAD_MAX_BYTES=5242880

# --- Mobile Money Payment Gateways (fill when merchant accounts are ready) ---
# Telesom ZAAD
ZAAD_API_URL=
ZAAD_MERCHANT_ID=
ZAAD_API_KEY=
ZAAD_WEBHOOK_SECRET=

# Hormuud EVC Plus
EVC_PLUS_API_URL=
EVC_PLUS_MERCHANT_ID=
EVC_PLUS_API_KEY=
EVC_PLUS_WEBHOOK_SECRET=

# Somtel e-Dahab
EDAHAB_API_URL=
EDAHAB_MERCHANT_ID=
EDAHAB_API_KEY=
EDAHAB_WEBHOOK_SECRET=
