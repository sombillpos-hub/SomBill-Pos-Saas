# Production values. Copy to .env next to this file (never commit it).
# Copy to .env (never commit it) and replace every value. Use long random passwords: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
IDENTITY_DB_MIGRATOR_PASSWORD=change-me
IDENTITY_DB_APP_PASSWORD=change-me
ORGANIZATION_DB_MIGRATOR_PASSWORD=change-me
ORGANIZATION_DB_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_USER=sombill
RABBITMQ_PASSWORD=change-me
# Browser origins allowed to call the API (dashboards, website), comma-separated
CORS_ORIGINS=https://app.sombill.com
# HTTPS only
COOKIE_SECURE=true
LOG_LEVEL=info
DOCS_ENABLED=false
# Dashboards build (public values only: they are bundled into the browser). Supabase is today's live backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=/api/v1
# Folder with fullchain.pem and privkey.pem
TLS_CERT_DIR=/etc/sombill/certs
