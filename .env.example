# SomBill - every environment variable in one place (documentation only).
# Each app still reads its OWN .env file (path shown in each section). Copy only the section you need into that file,
# never commit real values. This file is generated from the per-app .env.example files; keep them in sync.

####################################################################################################
# Docker Compose stack (copy to infrastructure/docker/.env)
# source: infrastructure/docker/.env.example
####################################################################################################
# Copy to .env (never commit it) and replace every value. Use long random passwords: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
IDENTITY_DB_MIGRATOR_PASSWORD=change-me
IDENTITY_DB_APP_PASSWORD=change-me
ORGANIZATION_DB_MIGRATOR_PASSWORD=change-me
ORGANIZATION_DB_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_USER=sombill
RABBITMQ_PASSWORD=change-me
# Browser origins allowed to call the API (dashboards, website), comma-separated
CORS_ORIGINS=http://localhost:3000
# Set to false only for plain-http local testing; production must use HTTPS + true
COOKIE_SECURE=false
LOG_LEVEL=info
DOCS_ENABLED=true

####################################################################################################
# api-gateway (backend/apps/api-gateway/.env)
# source: backend/apps/api-gateway/.env.example
####################################################################################################
# API Gateway. Copy to .env for local development (never commit .env).
PORT=4000
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
JWT_PUBLIC_KEY_FILE=../../../infrastructure/secrets/jwt-public.pem
MAIN_API_URL=http://localhost:4001
# Website and dashboards (both on 3000 in development)
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
DOCS_ENABLED=true

####################################################################################################
# main-api (backend/apps/main-api/.env)
# source: backend/apps/main-api/.env.example
####################################################################################################
# Main API (identity + organization modules). Copy to .env for local development (never commit .env).
PORT=4001
LOG_LEVEL=info
# One PostgreSQL database per module. Use the migrator role for `pnpm db:migrate`, the app role for running the API.
IDENTITY_DATABASE_URL=postgresql://identity_app:change-me@localhost:5432/sombill_identity
ORGANIZATION_DATABASE_URL=postgresql://organization_app:change-me@localhost:5432/sombill_organization
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# PEM files from scripts/generate-jwt-keys.sh (or JWT_PRIVATE_KEY / JWT_PUBLIC_KEY as base64)
JWT_PRIVATE_KEY_FILE=../../../infrastructure/secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=../../../infrastructure/secrets/jwt-public.pem
# Local plain-http only. Production: true (HTTPS)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
TRIAL_DAYS=14
TRIAL_MAX_BRANCHES=3
# File uploads (local-disk storage; a persistent volume in Docker)
STORAGE_LOCAL_DIR=./storage
UPLOAD_MAX_BYTES=5242880

####################################################################################################
# Dashboards (frontend/dashboards/.env.local)
# source: frontend/dashboards/.env.example
####################################################################################################
# Copy to .env.local and fill in. Only PUBLIC values belong here: this file is bundled into the browser.

# Supabase (the backend the dashboards run on today) → Project Settings → API
# NEVER put the service-role key in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SomBill API Gateway (Axios client in src/api/httpClient.ts)
VITE_API_BASE_URL=https://api.sombill.com/api/v1
# Endpoint that exchanges the httpOnly refresh-token cookie for a new access token
VITE_API_REFRESH_PATH=/auth/refresh
VITE_API_TIMEOUT_MS=20000

# Socket.IO real-time server (src/api/socket.ts)
VITE_SOCKET_URL=https://api.sombill.com
VITE_SOCKET_PATH=/socket.io

# Sign-in screen (all optional)
# Support button on the login card. Defaults come from the public website.
VITE_SUPPORT_EMAIL=support@sombill.com
VITE_SUPPORT_WHATSAPP=+252634408910
# A customer-facing menu page. The "View Customer Public Menu" link is hidden until this is set.
VITE_PUBLIC_MENU_URL=
# Shows "Google" on the login card. Enable the Google provider in Supabase Auth first.
VITE_AUTH_GOOGLE=false

####################################################################################################
# Website (frontend/website/.env.local)
# source: frontend/website/.env.example
####################################################################################################
# SomBill Public Website — Public Client Environment Variables
# Copy to .env.local for local development overrides if needed.
VITE_SITE_URL="https://sombill.com"
VITE_DEFAULT_THEME="light"
VITE_DEFAULT_LANGUAGE="en"
VITE_DEFAULT_EXCHANGE_RATE="11801"
