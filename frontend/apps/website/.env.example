# SomBill Public Website — Public Client Environment Variables
# Copy to .env.local for local development overrides if needed.
VITE_SITE_URL="https://sombill.com"
VITE_DEFAULT_THEME="light"
VITE_DEFAULT_LANGUAGE="en"
VITE_DEFAULT_EXCHANGE_RATE="11801"
# Where "Log In" and /login send visitors (the dashboards app). In development both apps share http://localhost:3000
VITE_DASHBOARDS_URL="https://app.sombill.com"
# SomBill Backend API base URL for Demo, Contact & Newsletter forms (defaults to /api/v1 on same origin)
VITE_API_URL="/api/v1"
